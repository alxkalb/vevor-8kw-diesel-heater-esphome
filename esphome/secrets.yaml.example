# Copy this file to secrets.yaml (same folder as the heater YAML) and fill in YOUR values.
# secrets.yaml is listed in .gitignore. Never commit real values.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Home Assistant API encryption key: a base64 string of 32 bytes.
# Generate one in the ESPHome dashboard (New device wizard) or with:  openssl rand -base64 32
ha_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Password for over-the-air updates
ota_password: "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# Password of the fallback hotspot the ESP opens when it cannot join your Wi-Fi
ap_password: "REPLACE_WITH_AN_8_TO_63_CHAR_PASSWORD"
